# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_here
SALT_ROUNDS=12

# Browser client allowed by CORS
# Set to "*" locally 
CORS_ORIGIN="*"

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=task_management_db
DB_SYNC=none   # options: none|sync|alter|force (use 'none' in production; set explicitly to alter/force only for debugging)
DB_LOG=false
DB_TIMEZONE=+00:00
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Seeding/testing
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=Password123


